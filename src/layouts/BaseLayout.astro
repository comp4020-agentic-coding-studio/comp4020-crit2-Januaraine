---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const SITE_ROOT = "https://www.actwildlife.org.au";
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="images/homepage/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner">

        <!-- Logo -->
        <a class="logo" href="./" aria-label="ACT Wildlife home">
          <img
            src="images/homepage/logo-primary.png"
            alt="ACT Wildlife"
          />
        </a>

        <!-- Desktop Navigation -->
        <ul class="main-nav" id="main-nav">

  <li>
    <a href="./">Home</a>
  </li>

  <li class="has-dropdown">
    <a href={`${SITE_ROOT}/get-involved`} aria-expanded="false">
      Get Involved
      <span class="dropdown-arrow">⌄</span>
    </a>

    <ul class="dropdown-menu">
      <li>
        <a href={`${SITE_ROOT}/get-involved/become-a-member`}>
          Become a Member
        </a>
      </li>
      <li>
        <a href={`${SITE_ROOT}/become-a-volunteer`}>
          Become a Volunteer
        </a>
      </li>
      <li>
        <a href={`${SITE_ROOT}/become-a-carer`}>
          Become a Carer
        </a>
      </li>
      <li>
        <a href={`${SITE_ROOT}/sponsor-a-species`}>
          Sponsor a Species
        </a>
      </li>
    </ul>
  </li>

  <li class="has-dropdown">
    <a href={`${SITE_ROOT}/training`} aria-expanded="false">
      Training
      <span class="dropdown-arrow">⌄</span>
    </a>

    <ul class="dropdown-menu">
      <li><a href="#">Orientation</a></li>
      <li><a href="#">Bat Courses</a></li>
      <li><a href="#">Bird Courses</a></li>
      <li><a href="#">Phone and Transport</a></li>
      <li><a href="#">Possum Courses</a></li>
      <li><a href="#">Reptile Course</a></li>
      <li><a href="#">Wombat Course</a></li>
      <li><a href="#">Training Calendar</a></li>
    </ul>
  </li>

  <li>
    <a href={`${SITE_ROOT}/about`}>About Us</a>
  </li>

  <li>
    <a href={`${SITE_ROOT}/contact-us`}>Contact Us</a>
  </li>

  <li class="has-dropdown login-nav-item">
    <a href="#login" aria-expanded="false">
      Login
      <span class="dropdown-arrow">⌄</span>
    </a>

    <ul class="dropdown-menu">
      <li>
        <a href={`${SITE_ROOT}/members-login`}>
          Members Login
        </a>
      </li>
      <li>
        <a href={`${SITE_ROOT}/wildman-login`}>
          Wildman Login
        </a>
      </li>
    </ul>
  </li>

</ul>

        <!-- Right side actions -->
        <div class="header-actions">

          <!-- Hotline -->
          <a
            class="header-hotline"
            href="tel:0432300033"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.9.8.6 0 1 .4 1 1v3.5c0 .6-.4 1-1 1C10.6 21.3 2.7 13.4 2.7 3.7c0-.6.4-1 1-1H7.2c.6 0 1 0 1 1 0 1.4.3 2.7.8 3.9.2.3.1.7-.2 1L6.6 10.8z"
              ></path>
            </svg>
            <span>0432 300 033</span>
          </a>

          <!-- Login -->
          <div class="header-login has-dropdown">
            <a href="#login">
              Login
              <span class="dropdown-arrow">⌄</span>
            </a>
            <ul class="dropdown-menu">
              <li>
                <a href={`${SITE_ROOT}/members-login`}>
                  Members Login
                </a>
              </li>
              <li>
                <a href={`${SITE_ROOT}/wildman-login`}>
                  Wildman Login
                </a>
              </li>
            </ul>
          </div>

          <!-- Donate -->
          <a
            class="header-donate"
            href={`${SITE_ROOT}/donate`}
          >
            Donate
          </a>

        </div>

        <!-- Mobile menu button -->
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-nav"
          aria-label="Toggle navigation menu"
        >
          <span class="nav-toggle-bars"></span>
        </button>

      </div>
    </header>
    <div class="nav-backdrop" id="nav-backdrop"></div>
    <main>
      <slot />
    </main>
    <a class="hotline-pill floating-hotline" id="floating-hotline" href="tel:0432300033">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.9.8.6 0 1 .4 1 1v3.5c0 .6-.4 1-1 1C10.6 21.3 2.7 13.4 2.7 3.7c0-.6.4-1 1-1H7.2c.6 0 1 .4 1 1 0 1.4.3 2.7.8 3.9.2.3.1.7-.2 1L6.6 10.8z"
        ></path>
      </svg>
      <span class="hotline-text"><span class="hotline-label">24/7 Hotline: </span>0432 300 033</span>
    </a>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col footer-brand">
          <a class="footer-logo" href="./">
            <img src="images/homepage/logo-footer.png" alt="ACT Wildlife home" />
          </a>
          <ul class="footer-social">
            <li>
              <a href="https://www.facebook.com/ACT.Wildlife" aria-label="ACT Wildlife on Facebook" title="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.instagram.com/act_wildlife" aria-label="ACT Wildlife on Instagram" title="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <nav class="footer-col" aria-label="Quick links">
          <h2>Quick Links</h2>
          <ul>
            <li><a href="./">Home</a></li>
            <li><a href="#get-involved-heading">Get Involved</a></li>
            <li><a href="#training">Training</a></li>
            <li><a href={`${SITE_ROOT}/about`}>About Us</a></li>
            <li><a href={`${SITE_ROOT}/contact-us`}>Contact Us</a></li>
            <li><a href={`${SITE_ROOT}/donate`}>Donate</a></li>
          </ul>
        </nav>

        <div class="footer-col footer-contact">
          <h2>Contact</h2>
          <p class="footer-label">24/7 Rescue Hotline</p>
          <a class="footer-tel" href="tel:0432300033">0432 300 033</a>
          <p class="footer-label">Find Us</p>
          <address>
            Jerrabomberra Wetlands<br />
            Dairy Rd, Fyshwick ACT 2609
          </address>
          <p class="footer-label">Office Hours</p>
          <p>Mon&ndash;Fri 9am&ndash;5pm<br />Sat 9am&ndash;3pm<br />Sun closed</p>
        </div>
      </div>
      <div class="footer-legal">
        <p>© Copyright 2026 ACT Wildlife</p>
        <nav aria-label="Legal">
          <a href={`${SITE_ROOT}/privacy`}>Privacy Policy</a>
        </nav>
        <a
          class="funraisin-credit"
          href="http://www.funraisin.co?utm_medium=customer&utm_source=ACT+Wildlife"
        >
          Powered by Funraisin
        </a>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const nav = document.getElementById("main-nav");
      const toggle = document.getElementById("nav-toggle");
      const backdrop = document.getElementById("nav-backdrop");

      const openNav = () => {
        nav?.classList.add("is-open");
        backdrop?.classList.add("is-open");
        toggle?.classList.add("is-open");
        document.body.classList.add("nav-open");
        toggle?.setAttribute("aria-expanded", "true");
      };

      const closeNav = () => {
        nav?.classList.remove("is-open");
        backdrop?.classList.remove("is-open");
        toggle?.classList.remove("is-open");
        document.body.classList.remove("nav-open");
        toggle?.setAttribute("aria-expanded", "false");
        nav?.querySelectorAll("li.has-dropdown.is-expanded").forEach((item) => {
          item.classList.remove("is-expanded");
          item.querySelector(":scope > a")?.setAttribute("aria-expanded", "false");
        });
      };

      toggle?.addEventListener("click", () => {
        if (nav?.classList.contains("is-open")) {
          closeNav();
        } else {
          openNav();
        }
      });

      backdrop?.addEventListener("click", closeNav);

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav?.classList.contains("is-open")) {
          closeNav();
        }
      });

      const isMobileNav = () => window.matchMedia("(max-width: 767px)").matches;

      nav?.querySelectorAll("li.has-dropdown > a").forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          if (!isMobileNav()) {
            return;
          }
          event.preventDefault();
          const item = trigger.parentElement;
          const isExpanded = item?.classList.toggle("is-expanded");
          trigger.setAttribute("aria-expanded", isExpanded ? "true" : "false");
        });
      });

      nav?.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof HTMLElement && target.tagName === "A") {
          if (isMobileNav() && target.parentElement?.classList.contains("has-dropdown")) {
            return;
          }
          closeNav();
        }
      });

      const hotline = document.getElementById("floating-hotline");

      hotline?.addEventListener("click", (event) => {
        if (!hotline.classList.contains("is-open")) {
          event.preventDefault();
          hotline.classList.add("is-open");
        }
      });

      hotline?.addEventListener("mouseleave", () => {
        hotline.classList.remove("is-open");
      });

      document.addEventListener("click", (event) => {
        if (!hotline?.classList.contains("is-open")) return;
        const target = event.target;
        if (target instanceof Node && !hotline.contains(target)) {
          hotline.classList.remove("is-open");
        }
      });

      let ticking = false;
      const updateHeaderShadow = () => {
        header?.classList.toggle("is-scrolled", window.scrollY > 40);
        ticking = false;
      };
      window.addEventListener("scroll", () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeaderShadow);
          ticking = true;
        }
      });

      const setHeaderHeightVar = () => {
        if (header) {
          document.documentElement.style.setProperty("--header-height", `${header.offsetHeight}px`);
        }
      };
      setHeaderHeightVar();
      window.addEventListener("resize", setHeaderHeightVar);

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const initCarousel = (root: HTMLElement) => {
        const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
        const status = root.querySelector<HTMLElement>("[data-carousel-status]");
        const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-dot]"));
        const autoplayMs = Number(root.dataset.autoplay ?? 0);
        let active = 0;
        let autoplayId: number | undefined;
        let userStopped = false;

        const show = (index: number) => {
          active = (index + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            slide.hidden = i !== active;
          });
          if (status) status.textContent = `${active + 1} / ${slides.length}`;
          dots.forEach((dot, i) => {
            dot.setAttribute("aria-current", String(i === active));
          });
        };

        const pauseAutoplay = () => {
          if (autoplayId !== undefined) {
            window.clearInterval(autoplayId);
            autoplayId = undefined;
          }
        };

        const startAutoplay = () => {
          if (reduceMotion || !autoplayMs || userStopped || autoplayId !== undefined) return;
          autoplayId = window.setInterval(() => show(active + 1), autoplayMs);
        };

        const manualNav = (index: number) => {
          userStopped = true;
          pauseAutoplay();
          show(index);
        };

        root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => manualNav(active - 1));
        root.querySelector("[data-carousel-next]")?.addEventListener("click", () => manualNav(active + 1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => manualNav(i)));

        root.addEventListener("mouseenter", pauseAutoplay);
        root.addEventListener("mouseleave", startAutoplay);
        root.addEventListener("focusin", pauseAutoplay);
        root.addEventListener("focusout", startAutoplay);

        show(0);
        startAutoplay();
      };

      document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);

      const revealTargets = document.querySelectorAll("[data-animate]");
      if ("IntersectionObserver" in window && revealTargets.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );
        revealTargets.forEach((el) => observer.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
