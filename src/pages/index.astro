---
import BaseLayout from "../layouts/BaseLayout.astro";

const SITE_ROOT = "https://www.actwildlife.org.au";

const getInvolvedCards = [
  {
    title: "Become a Member",
    description:
      "A $40 annual membership supports our work and is the first step toward volunteering or caring for wildlife.",
    href: `${SITE_ROOT}/get-involved/become-a-member`,
    icon: "M8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM16 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3 2.5-5 6-5s6 2 6 5M14 20c0-2.5 2-4.5 5-4.5s5 2 5 4.5",
  },
  {
    title: "Become a Volunteer",
    description:
      "Help without hands-on animal care — phone duty, transport, pouch-knitting, aviary building, and more.",
    href: `${SITE_ROOT}/become-a-volunteer`,
    icon: "M7 11V7a2 2 0 0 1 4 0v5m0-4a2 2 0 0 1 4 0v4m0-3a2 2 0 0 1 4 0v5c0 3.5-2.5 6-6 6h-1c-2.5 0-4-1-5.5-3L4 15c-.5-.7-.3-1.5.5-1.8.7-.3 1.3 0 1.8.6L8 16",
  },
  {
    title: "Become a Carer",
    description:
      "Take injured, sick, or orphaned native animals into your own home under licence, with full training provided.",
    href: `${SITE_ROOT}/become-a-carer`,
    icon: "M4 12 12 5l8 7M6 11v8a1 1 0 0 0 1 1h4v-5h2v5h4a1 1 0 0 0 1-1v-8",
  },
  {
    title: "Sponsor a Species",
    description:
      "Support the ongoing care of bats, birds, possums, reptiles, or wombats with a recurring sponsorship.",
    href: `${SITE_ROOT}/sponsor-a-species`,
    icon: "M9 8.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM15 8.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM6 12.5A1.5 1.5 0 1 1 3 12.5a1.5 1.5 0 0 1 3 0zM18 12.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM12 12c-2.5 0-5 2-5 4.5S9 20 12 20s5-1 5-3.5S14.5 12 12 12z",
  },
];

const galleryPhotos = [
  {
    src: "card-become-a-volunteer.jpg",
    alt: "An ACT Wildlife volunteer helping care for a rescued flying-fox",
  },
  {
    src: "card-become-a-carer.jpg",
    alt: "An ACT Wildlife carer looking after a rescued native animal at home",
  },
];
---

<BaseLayout
  title="ACT Wildlife — Rescue Rehabilitate Release"
  description="ACT Wildlife is a not-for-profit organisation rescuing, rehabilitating, and releasing native wildlife across the ACT."
>
  <section class="hero-banner" aria-label="Featured">
    <div class="hero-slide">
      <img
        class="hero-bg"
        src="images/homepage/hero-banner.jpg"
        alt="An ACT Wildlife carer holding a rescued native animal"
      />
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1>Rescue Rehabilitate Release</h1>
        <p>
          ACT Wildlife is a not-for-profit organisation caring for native wildlife across the ACT since 1993.
        </p>
        <a class="mission-link" href={`${SITE_ROOT}/about`}>
          Learn about our mission →
        </a>
        <a class="hero-donate" href={`${SITE_ROOT}/donate`}>Donate Now</a>
      </div>
    </div>
  </section>

  <section class="notices" aria-labelledby="notices-heading">
    <div class="notice-panel">
      <h2 id="notices-heading">Notices &amp; Current Campaigns</h2>
      <div class="notice-grid">
        <div class="notice-item notice-alert">
          <span class="notice-tag">
            <svg class="notice-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <line x1="12" y1="9" x2="12" y2="13" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
            Bird Flu Update
          </span>
          <h3>Bird Flu (Avian Influenza) — Update</h3>
          <p>
            ACT Wildlife is monitoring the current bird flu situation and
            following the latest advice. If you find a sick or dead bird,
            report it to the Emergency Animal Disease Hotline on{" "}
            <span class="notice-highlight">
              <strong>1800 675 888</strong> — a separate government hotline
              for reporting bird flu, not an ACT Wildlife number.
            </span>{" "}
            For sick, injured, or orphaned native wildlife, use our own 24/7
            hotline above.{" "}
            <span class="notice-more-info">
              More information:{" "}
              <a href="http://www.birdflu.gov.au/" rel="noopener">birdflu.gov.au</a>.
            </span>
          </p>
        </div>
        <div class="notice-item notice-campaign">
          <span class="notice-tag">
            <svg class="notice-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            Netting Swap
          </span>
          <h3>Wildlife Friendly Netting Swap</h3>
          <p>
            Swap your fruit-tree netting for wildlife-safe netting — the ACT
            banned large-aperture netting in April 2024. Upcoming swap
            sessions run{" "}
            <span class="notice-highlight">
              <strong>
                10:30am and 12:30pm on Saturdays 29 August, 12 September,
                26 September, and 10 October 2026
              </strong>
            </span>{" "}
            (ACT residents only).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="get-involved" aria-labelledby="get-involved-heading">
    <h2 class="section-heading" id="get-involved-heading" data-animate>Get Involved</h2>
    <p class="section-lead" data-animate>
      There are four ways to support ACT Wildlife — find the one that fits you.
    </p>
    <div class="card-grid">
      {
        getInvolvedCards.map((card, index) => (
          <div class="card" data-animate style={`--delay: ${index * 100}ms`}>
            <div class="card-icon-panel" role="img" aria-label={`${card.title} — ACT Wildlife`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d={card.icon}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </div>
            <div class="card-body">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <a href={card.href}>Learn more →</a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="gallery" aria-labelledby="gallery-heading" data-animate data-carousel>
    <h2 class="section-heading" id="gallery-heading">From Our Rescues</h2>
    <div class="gallery-viewport">
      {
        galleryPhotos.map((photo, index) => (
          <img
            class="gallery-slide"
            data-slide
            src={`images/homepage/${photo.src}`}
            alt={photo.alt}
            hidden={index !== 0}
          />
        ))
      }
      <button class="carousel-control carousel-prev" type="button" aria-label="Previous photo" data-carousel-prev>
        ‹
      </button>
      <button class="carousel-control carousel-next" type="button" aria-label="Next photo" data-carousel-next>
        ›
      </button>
    </div>
    <p class="gallery-status" aria-live="polite" data-carousel-status>1 / {galleryPhotos.length}</p>
  </section>

  <section class="donation-cta" aria-labelledby="donate-heading" data-animate>
    <div class="donation-cta-inner">
      <h2 id="donate-heading">Support Our Work</h2>
      <p>Your donation means everything to our wildlife.</p>
      <a class="button-donate" href={`${SITE_ROOT}/donate`}>Donate to Support Our Work</a>
      <p class="sponsor-note">
        Founded with early support from IFAW and the ACT Herpetological Association.
      </p>
    </div>
  </section>
</BaseLayout>
